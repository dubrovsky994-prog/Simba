# Telegram Bot API credentials used by api/lead.ts (site lead form) and
# api/telegram/webhook.ts (SIMBA Telegram bot) to deliver messages.
# Create a bot via @BotFather, then message it once and read the chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates (or use @userinfobot for a personal chat id).
# Set these in Vercel: Project Settings -> Environment Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shared secret Telegram sends back in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook call, so api/telegram/webhook.ts can reject requests
# that don't come from Telegram. Generate any long random string, set it here
# and in Vercel, then pass the same value as secret_token when calling
# setWebhook (see README/deploy notes for the exact URL).
TELEGRAM_WEBHOOK_SECRET=
